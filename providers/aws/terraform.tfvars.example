# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored - never commit your real values.

aws_region   = "us-east-1"
cluster_name = "clusterdrill-lab"
worker_count = 1

# Your own SSH public key - e.g. `cat ~/.ssh/id_ed25519.pub`.
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Your own IP's /32, or a CIDR you control (VPN, office network). Find your
# current public IP with `curl -s https://checkip.amazonaws.com`.
allowed_ssh_cidr = "203.0.113.4/32"

control_plane_instance_type = "t3.medium"
worker_instance_type        = "t3.medium"

# Defaults to "amd64" for both if omitted. Set to "arm64" for a Graviton
# instance type (e.g. t4g.small, m7g.large) - control-plane and workers
# may use different architectures from each other.
# control_plane_architecture = "arm64"
# worker_architecture        = "arm64"

# Only needed if the defaults (10.42.0.0/16 / 10.42.1.0/24) collide with
# your own network, or you want to run more than one lab at once.
# vpc_cidr           = "10.43.0.0/16"
# public_subnet_cidr = "10.43.1.0/24"

# Defaults to the first AZ AWS returns for aws_region if omitted.
# availability_zone = "us-east-1a"

# Defaults to gp3/30 if omitted.
# root_volume_type    = "gp3"
# root_volume_size_gb = 30
